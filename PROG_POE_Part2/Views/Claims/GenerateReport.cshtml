@model IEnumerable<ClaimViewModel>

<head>
    <style>
        /* Style the table header and table data */
        th, td {
            padding: 8px;
            vertical-align: middle;
        }

        /* Ensure headers and data cells are aligned properly */
        th {
            text-align: center;
        }

        td {
            text-align: center; /* Default alignment for non-numeric columns */
        }

        .button-container {
            display: flex;
            gap: 10px; /* Adjust space between buttons */
        }
    </style>
</head>

<h2>Approved Claims</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Claim ID</th>
            <th>Lecturer Name</th>
            <th>Hours Worked</th>
            <th>Hourly Rate</th>
            <th>Total Amount</th>
            <th>Date Submitted</th>
            <th>Status</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in Model)
        {
            <tr>
                <td>@claim.ClaimId</td>
                <td>@claim.LecturerName</td>
                <td>@claim.HoursWorked</td>
                <td>@claim.HourlyRate.ToString("C")</td>
                <td>@claim.TotalAmount.ToString("C")</td> <!-- Display TotalAmount here -->
                <td>@claim.DateSubmitted.ToString("dd MMM yyyy")</td>
                <td>@claim.Status</td>
                <td>@claim.Notes</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3 button-container">
    <!-- Export to Excel Button -->
    <form asp-controller="HR" asp-action="ExportToExcel" method="post">
        <button type="submit" class="btn btn-success">Export to Excel</button>
    </form>

    <!-- View Users Button -->
    <a href="@Url.Action("ViewUsers", "HR")" class="btn btn-info">View Users</a>
</div>
