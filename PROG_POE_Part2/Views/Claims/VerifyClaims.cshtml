@model List<ClaimViewModel>

<div class="container mt-5">
    <h2 class="text-center mb-4">Pending Claims Verification</h2>

    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Claim ID</th>
                <th>Hours Worked</th>
                <th>Hourly Rate</th>
                <th>Total Amount</th>
                <th>Date Submitted</th>
                <th>Notes</th>
                <th>Document</th> <!-- Add a new column for Document -->
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.ClaimId</td>
                    <td>@claim.HoursWorked</td>
                    <td>@String.Format("{0:C}", claim.HourlyRate)</td>
                    <td>@String.Format("{0:C}", (claim.HoursWorked * claim.HourlyRate))</td>
                    <td>@claim.DateSubmitted.ToShortDateString()</td>
                    <td>@claim.Notes</td>
                    <td class="document-cell">
                        @if (!string.IsNullOrEmpty(claim.DocumentPath))
                        {
                            // Ensure the DocumentPath starts with "uploads/"
                            var documentPath = claim.DocumentPath.StartsWith("/") ? claim.DocumentPath : "/" + claim.DocumentPath;
                            <a href="@Url.Content("~/uploads/" + System.IO.Path.GetFileName(claim.DocumentPath))" target="_blank">
                                @System.IO.Path.GetFileName(claim.DocumentPath)
                            </a>
                        }
                        else
                        {
                            <span>No Document</span>
                        }
                    </td>

                    <td>
                        <form asp-action="ApproveClaim" asp-controller="Claims" method="post" style="display:inline;">
                            <input type="hidden" name="ClaimId" value="@claim.ClaimId" />
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>
                        <form asp-action="RejectClaim" asp-controller="Claims" method="post" style="display:inline;">
                            <input type="hidden" name="ClaimId" value="@claim.ClaimId" />
                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
