@model List<ClaimViewModel>

<h2 class="text-center my-4">My Claims</h2>

<div class="container">
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Claim ID</th>
                    <th>Hours Worked</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Progress</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.ClaimId</td>
                        <td>@claim.HoursWorked</td>
                        <td>@String.Format("{0:C}", (claim.HoursWorked * claim.HourlyRate))</td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(claim.Status)">@claim.Status</span>
                        </td>
                        <td>
                            <!-- Progress Bar -->
                            <div class="progress">
                                <div class="progress-bar @GetProgressBarClass(claim.Status)" role="progressbar"
                                     style="width: @GetProgressPercentage(claim.Status)%;"
                                     aria-valuenow="@GetProgressPercentage(claim.Status)" aria-valuemin="0"
                                     aria-valuemax="100">
                                    @claim.Status
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private string GetProgressBarClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private int GetProgressPercentage(string status)
    {
        return status switch
        {
            "Pending" => 50,
            "Approved" => 100,
            "Rejected" => 100,
            _ => 0
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
