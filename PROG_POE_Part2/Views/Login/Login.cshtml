@model LoginViewModel

<h2>Login</h2>

<form asp-controller="Login" asp-action="Login" method="post">
    <div>
        <label asp-for="Username"></label>
        <input asp-for="Username" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div>
        <button type="submit">Login</button>
    </div>

    <!-- Display any general errors -->
    <div>
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState[""].Errors.First().ErrorMessage</span>
        }
    </div>
</form>
