@model ReportViewModel

<h2 class="text-center mt-4">Generate Reports</h2>

<div class="card mx-auto mt-4" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Generate">
            <div class="mb-3">
                <label class="form-label">Select Report:</label>
                <select asp-for="SelectedReport" asp-items="Model.ReportOptions" class="form-select">
                    <option>Monthly Claim Summary</option>
                    <option>Unpaid Invoices</option>
                    <option>Approved Claims</option>
                    <option>Pending Claims</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Date Range:</label>
                <div class="d-flex">
                    <input type="date" asp-for="StartDate" class="form-control me-2" />
                    <span class="align-self-center">to</span>
                    <input type="date" asp-for="EndDate" class="form-control ms-2" />
                </div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <input type="submit" value="Generate Report" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<h3 class="text-center mt-5">Export Report</h3>

<div class="card mx-auto mt-3" style="max-width: 600px;">
    <div class="card-body text-center">
        <form asp-action="Export">
            <div class="d-grid gap-2">
                <input type="submit" value="Export as PDF" class="btn btn-danger" />
                <input type="submit" value="Export as Excel" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>
