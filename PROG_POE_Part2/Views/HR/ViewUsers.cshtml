@model List<User>

<div class="container mt-5">
    <h2 class="text-center mb-4">Manage Users</h2>

    <table class="table table-striped table-bordered">
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <form asp-action="UpdateUser" asp-controller="HR" method="post" id="userForm_@user.Id" onsubmit="showModal()">
                            <!-- Same form for all fields -->
                            <input type="hidden" name="Id" value="@user.Id" /> <!-- Updated to use Id -->
                            <!-- Container with flexbox for fields to be displayed side by side -->
                            <div class="d-flex">
                                <!-- Username Field -->
                                <div class="form-group mr-2" style="flex: 2;">
                                    <input type="text" name="Username" value="@user.Username" class="form-control" />
                                </div>

                                <!-- Role Field -->
                                <div class="form-group mr-2" style="flex: 2;">
                                    <input type="text" name="Role" value="@user.Role" class="form-control" />
                                </div>

                                <!-- Contact Info Field -->
                                <div class="form-group mr-2" style="flex: 2;">
                                    <input type="text" name="ContactInfo" value="@user.ContactInfo" class="form-control" />
                                </div>

                                <!-- Save Button inside the form -->
                                <div class="form-group" style="flex: 1; display: flex; justify-content: center; align-items: center;">
                                    <button type="submit" class="btn btn-primary btn-sm w-75">Save</button>
                                </div>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>